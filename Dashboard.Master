<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Dashboard.master.cs" Inherits="FoodSaver.Dashboard" %>
<%-- Dashboard master page - shared layout with sidebar and main content area for logged-in users --%>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server" /> - FoodSaver</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="Content/css/site.css" rel="stylesheet" />
    <link href="Content/css/dashboard.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
<form id="form1" runat="server">

<div class="db-layout">
    <aside class="sidebar">
        <%-- Sidebar navigation - menu items change based on whether the user is a Donor or NGO --%>
    <a class="sidebar-brand" href="Default.aspx">
             <img src="Images/logo-dashboard.png" alt="FoodSaver" style="height:30px;" />
               <span>FoodSaver</span>
            </a>
        <ul class="sidebar-nav">
            <li><a href="Dashboard.aspx" id="navDash" runat="server"><i class="bi bi-grid"></i> Dashboard</a></li>

            <% if (Session["Role"] != null && Session["Role"].ToString() == "Donor") { %>
                <li><a href="DonateFood.aspx" id="navDonate" runat="server"><i class="bi bi-gift"></i> Donate Food</a></li>
                <li><a href="RequestFood.aspx" id="navRequest" runat="server"><i class="bi bi-hand-thumbs-up"></i> Request Food</a></li>
                <li><a href="MyDonations.aspx" id="navMy" runat="server"><i class="bi bi-clock-history"></i> My Donations</a></li>
            <% } %>

            <% if (Session["Role"] != null && Session["Role"].ToString() == "NGO") { %>
                <li><a href="RequestFood.aspx"><i class="bi bi-hand-thumbs-up"></i> Request Food</a></li>
                <li><a href="AvailableFood.aspx"><i class="bi bi-search"></i> Available Food</a></li>
            <% } %>

            <li><a href="Notifications.aspx" id="navNotif" runat="server"><i class="bi bi-bell"></i> Notifications</a></li>
            <li><a href="Profile.aspx" id="navProfile" runat="server"><i class="bi bi-person"></i> Profile</a></li>
            <li><a href="Logout.aspx" class="logout"><i class="bi bi-box-arrow-right"></i> Logout</a></li>
        </ul>

        <div class="sidebar-illustration">
            <img src="Images/grocery.png" alt="" />
        </div>
    </aside>

    <%-- Main content placeholder - each page injects its own content here --%> 
    <main class="db-main">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>
</div>

    <%-- Bootstrap JS bundle plus a placeholder for page-specific scripts --%>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
</form>
</body>
</html>